# Copy to ".env" in the project root. Never commit ".env" or AWS keys.
# Local development works with every value left at its default.

# --- API ---
PORT=4000
# Browser origins allowed to call the API (comma-separated). Add your HTTPS site in production.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PYTHON_BIN=
PREWARM_WORKER=true
SPARK_DRIVER_MEMORY=2g
# Increase if hadoop-aws jars are being downloaded for the first time on a slow network.
WORKER_START_TIMEOUT_MS=180000
# Per-request Spark query timeout (filtered requests via the long-lived worker).
WORKER_REQUEST_TIMEOUT_MS=120000
# Full path to a JDK 17 or 21 installation. Leave empty if JAVA_HOME is already set in your shell.
# On EC2: /usr/lib/jvm/java-21-amazon-corretto  or  /usr/lib/jvm/java-17-amazon-corretto
JAVA_HOME=
DEBUG_SPARK=false

# --- Data source: local (default) or s3 ---
DATA_SOURCE=local
ANALYTICS_INPUT=
OUTPUT_DIR=

# --- Spark tuning (optional overrides) ---
# Number of shuffle partitions. Default 8 is fine for local mode; increase on a cluster.
SPARK_SHUFFLE_PARTITIONS=8
# Override Spark master URL. Leave empty for local[*] (all CPU cores).
SPARK_MASTER=
# Set to "1" to enable S3A even when DATA_SOURCE=local (e.g., testing with a local input but writing to S3).
SPARK_ENABLE_S3=
# Override the hadoop-aws Maven coordinates. Default matches the Hadoop version bundled with PySpark.
# PySpark 4.x -> org.apache.hadoop:hadoop-aws:3.4.1
# PySpark 3.5.x -> org.apache.hadoop:hadoop-aws:3.3.4,com.amazonaws:aws-java-sdk-bundle:1.12.262
SPARK_HADOOP_AWS_PACKAGES=
# Provide local JAR paths (comma-separated) if Maven cannot download packages (air-gapped environments).
SPARK_HADOOP_AWS_JARS=
# Override S3A credential provider (leave empty to use the default chain: instance profile / env / shared config).
SPARK_S3A_CREDENTIALS_PROVIDER=
# S3A bind address (set to 0.0.0.0 on multi-homed hosts if Spark cannot resolve 127.0.0.1).
SPARK_DRIVER_BIND_ADDRESS=127.0.0.1

# --- Amazon S3 (required only when DATA_SOURCE=s3) ---
# Create the bucket yourself in the AWS console. Keep Block Public Access ON.
# Do not put AWS access keys in this file for EC2 — attach an IAM instance profile instead.
AWS_REGION=ap-south-1
S3_BUCKET=your-private-bucket-name
S3_INPUT_KEY=raw/orders.csv
S3_OUTPUT_PREFIX=processed
# Default: true when DATA_SOURCE=s3, false otherwise.
S3_WRITE_RESULTS=
# On API boot, copy the latest processed JSON from S3 into OUTPUT_DIR (DATA_SOURCE=s3 only).
S3_HYDRATE_ON_BOOT=true

# Local-only credential overrides (optional). Prefer `aws configure` or an EC2 instance profile.
# Uncomment ONLY for local testing — never commit these values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
