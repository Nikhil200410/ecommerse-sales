# Reverse proxy: TLS terminator in front of Express (port 4000 stays private).
# Replace EXAMPLE.com and the certificate paths after certbot.
# Do not expose 4000 on 0.0.0.0/0.

upstream analytics_api {
    server 127.0.0.1:4000;
}

server {
    listen 80;
    listen [::]:80;
    server_name EXAMPLE.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name EXAMPLE.com;

    ssl_certificate     /etc/letsencrypt/live/EXAMPLE.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/EXAMPLE.com/privkey.pem;

    root /opt/ecommerce-sales-analytics/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://analytics_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
